# Local Postgres for development
DATABASE_URL="postgresql://user@127.0.0.1:5432/fotbollsdoktorn?schema=public"
DIRECT_URL="postgresql://user@127.0.0.1:5432/fotbollsdoktorn?schema=public"
PORT=4000

# --- Production (Supabase) ---
# In Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL should use the "Transaction" pooler on port 6543 (adds ?pgbouncer=true).
# DIRECT_URL should use the direct connection on port 5432 (used only for migrations).
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
